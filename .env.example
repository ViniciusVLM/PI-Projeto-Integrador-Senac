# Copie este arquivo para .env e preencha com os dados do serviço MySQL no Aiven.
# Nunca coloque a senha real neste arquivo nem no código: ele vai para o GitHub.
# Sem essas variáveis, a API funciona com o arquivo server/db.json.
DB_HOST=seu-servico.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=coloque-a-senha-aqui
DB_NAME=SecureDesk
DB_SSL=true
