# ==============================================================================
# SecureDesk — Variáveis de Ambiente (.env)
# Copie este arquivo para .env na raiz do projeto. Nunca envie o .env ao GitHub.
# ==============================================================================

PORT=3000

# ------------------------------------------------------------------------------
# 1. Banco de Dados MySQL (Opcional — ex.: Aiven Cloud)
# Sem estas variáveis, a API opera automaticamente com server/db.json.
# ------------------------------------------------------------------------------
DB_HOST=seu-servico.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=coloque-a-senha-aqui
DB_NAME=SecureDesk
DB_SSL=true

# ------------------------------------------------------------------------------
# 2. Envio Real de E-mails via SMTP Externo Gratuito (Recuperação de Senha / Alertas)
# Opção A — Gmail Gratuito (até 500 e-mails/dia para qualquer destinatário):
#   1. Ative a Verificação em duas etapas na sua Conta Google (myaccount.google.com/security)
#   2. Acesse "Senhas de app" (myaccount.google.com/apppasswords) e gere uma senha de 16 letras
#   3. Preencha SMTP_USER com seu Gmail e SMTP_PASS com a senha de 16 letras (sem espaços)
#
# Opção B — Brevo Gratuito (brevo.com — até 300 e-mails/dia grátis):
#   SMTP_HOST=smtp-relay.brevo.com | SMTP_PORT=587 | SMTP_USER=seu-login-brevo | SMTP_PASS=chave-smtp
#
# Observação: Você também pode configurar e testar o SMTP diretamente pela tela
# "Configurações > E-mail (SMTP)" logado como Administrador!
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=SecureDesk Central de TI
SMTP_FROM_EMAIL=
